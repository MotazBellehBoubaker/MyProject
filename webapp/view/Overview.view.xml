<mvc:View
    controllerName="sentinel.security.controller.Overview"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page showNavButton="false" class="sentinelPage">
        <customHeader>
            <Bar>
                <contentLeft>
                    <Title text="Security Posture Overview" level="H4"/>
                    <ObjectStatus
                        id="scanStatus"
                        text="Last scan: SC-2026-031 · 14m ago"
                        state="Success"
                        icon="sap-icon://accept"
                        class="sapUiSmallMarginBegin"/>
                </contentLeft>
                <contentRight>
                    <Button text="Export" icon="sap-icon://download" press=".onExportOverview"/>
                    <Button
                        text="{= ${appState>/scanning} ? 'Scanning...' : 'Trigger Scan' }"
                        icon="{= ${appState>/scanning} ? 'sap-icon://refresh' : 'sap-icon://play' }"
                        type="Emphasized"
                        press=".onTriggerScan"
                        enabled="{= !${appState>/scanning} }"
                        class="sapUiSmallMarginBegin"/>
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <!-- Scan progress -->
            <ProgressIndicator
                visible="{appState>/scanning}"
                percentValue="{= ${appState>/scanProgress} * 100 }"
                displayValue="{= 'Scanning ' + Math.round(${appState>/scanProgress} * 100) + '%' }"
                state="Information"
                class="sapUiNoMargin"/>

            <VBox class="sapUiMediumMargin">

                <!-- KPI Row -->
                <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
                    <GenericTile
                        header="System Risk Score"
                        subheader="30-day window · lower is better"
                        press=".onNavTo"
                        frameType="TwoByOne"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent>
                            <TileContent footer="↑ +4 since last scan">
                                <content>
                                    <NumericContent value="78" indicator="Up" valueColor="Critical" withMargin="false"/>
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>

                    <GenericTile
                        header="Open Violations"
                        subheader="7 High · 8 Medium · 3 Low"
                        press=".onViewAllViolations"
                        frameType="TwoByOne"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent>
                            <TileContent footer="↑ +3 new this scan">
                                <content>
                                    <NumericContent value="18" indicator="Up" valueColor="Critical" withMargin="false"/>
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>

                    <GenericTile
                        header="Critical Roles"
                        subheader="SAP_ALL · Firefighter · Wildcard"
                        press=".onNavToCritical"
                        frameType="TwoByOne"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent>
                            <TileContent footer="2 SAP_ALL · 2 Firefighter">
                                <content>
                                    <NumericContent value="4" valueColor="Critical" withMargin="false"/>
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>

                    <GenericTile
                        header="Compliance"
                        subheader="3 components outdated"
                        press=".onNavToCompliance"
                        frameType="TwoByOne"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent>
                            <TileContent unit="%" footer="↑ +2% vs last scan">
                                <content>
                                    <NumericContent value="82" indicator="Up" valueColor="Good" withMargin="false"/>
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>

                    <GenericTile
                        header="Users Scanned"
                        subheader="4,212 active · 2 locked"
                        frameType="TwoByOne"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent>
                            <TileContent footer="87 with excessive privileges">
                                <content>
                                    <NumericContent value="4218" valueColor="Neutral" withMargin="false"/>
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>
                </HBox>

                <!-- Charts Row - single HTML block for perfect layout control -->
                <core:HTML content="&lt;div style='display:flex;gap:16px;margin-bottom:16px;align-items:stretch'&gt;

                    &lt;!-- Trend Chart --&gt;
                    &lt;div style='flex:3;background:#fff;border:1px solid #d9dbdd;border-radius:8px;padding:16px;box-shadow:0 1px 4px rgba(0,0,0,0.06)'&gt;
                        &lt;div style='font-size:13px;font-weight:600;color:#1d2d3e;margin-bottom:12px'&gt;Risk Score &amp;amp; Violations Trend &amp;mdash; Last 30 Scans&lt;/div&gt;
                        &lt;svg width='100%' height='150' viewBox='0 0 600 150' preserveAspectRatio='none' style='display:block'&gt;
                            &lt;defs&gt;
                                &lt;linearGradient id='rg2' x1='0' y1='0' x2='0' y2='1'&gt;
                                    &lt;stop offset='0%' stop-color='%230070f2' stop-opacity='0.2'/&gt;
                                    &lt;stop offset='100%' stop-color='%230070f2' stop-opacity='0'/&gt;
                                &lt;/linearGradient&gt;
                                &lt;linearGradient id='vg2' x1='0' y1='0' x2='0' y2='1'&gt;
                                    &lt;stop offset='0%' stop-color='%23bb0000' stop-opacity='0.12'/&gt;
                                    &lt;stop offset='100%' stop-color='%23bb0000' stop-opacity='0'/&gt;
                                &lt;/linearGradient&gt;
                            &lt;/defs&gt;
                            &lt;line x1='0' y1='30' x2='600' y2='30' stroke='%23f0f0f0' stroke-width='1'/&gt;
                            &lt;line x1='0' y1='70' x2='600' y2='70' stroke='%23f0f0f0' stroke-width='1'/&gt;
                            &lt;line x1='0' y1='110' x2='600' y2='110' stroke='%23f0f0f0' stroke-width='1'/&gt;
                            &lt;text x='2' y='28' font-size='9' fill='%23bbb' font-family='Arial'&gt;100&lt;/text&gt;
                            &lt;text x='2' y='68' font-size='9' fill='%23bbb' font-family='Arial'&gt;75&lt;/text&gt;
                            &lt;text x='2' y='108' font-size='9' fill='%23bbb' font-family='Arial'&gt;50&lt;/text&gt;
                            &lt;polygon points='20,112 80,104 140,108 200,94 260,99 320,84 380,89 440,74 500,68 560,58 600,50 600,150 20,150' fill='url(%23rg2)'/&gt;
                            &lt;polyline points='20,112 80,104 140,108 200,94 260,99 320,84 380,89 440,74 500,68 560,58 600,50' fill='none' stroke='%230070f2' stroke-width='2.5' stroke-linejoin='round'/&gt;
                            &lt;polygon points='20,128 80,122 140,124 200,114 260,118 320,106 380,110 440,98 500,92 560,84 600,78 600,150 20,150' fill='url(%23vg2)'/&gt;
                            &lt;polyline points='20,128 80,122 140,124 200,114 260,118 320,106 380,110 440,98 500,92 560,84 600,78' fill='none' stroke='%23bb0000' stroke-width='1.8' stroke-linejoin='round'/&gt;
                            &lt;circle cx='600' cy='50' r='5' fill='%230070f2'/&gt;
                            &lt;circle cx='600' cy='78' r='4' fill='%23bb0000'/&gt;
                        &lt;/svg&gt;
                        &lt;div style='display:flex;gap:16px;margin-top:8px'&gt;
                            &lt;span style='display:flex;align-items:center;gap:5px;font-size:11px;color:%23555'&gt;&lt;span style='width:14px;height:3px;background:%230070f2;border-radius:2px;display:inline-block'&gt;&lt;/span&gt;Risk Score&lt;/span&gt;
                            &lt;span style='display:flex;align-items:center;gap:5px;font-size:11px;color:%23555'&gt;&lt;span style='width:14px;height:3px;background:%23bb0000;border-radius:2px;display:inline-block'&gt;&lt;/span&gt;Violations&lt;/span&gt;
                        &lt;/div&gt;
                    &lt;/div&gt;

                    &lt;!-- Compliance Gauge --&gt;
                    &lt;div style='flex:1;background:%23fff;border:1px solid %23d9dbdd;border-radius:8px;padding:16px;box-shadow:0 1px 4px rgba(0,0,0,0.06);display:flex;flex-direction:column;align-items:center'&gt;
                        &lt;div style='font-size:13px;font-weight:600;color:%231d2d3e;margin-bottom:8px;text-align:center'&gt;Compliance Score&lt;/div&gt;
                        &lt;svg width='160' height='100' viewBox='0 0 160 100'&gt;
                            &lt;defs&gt;
                                &lt;linearGradient id='gg2' x1='0%' y1='0%' x2='100%' y2='0%'&gt;
                                    &lt;stop offset='0%' stop-color='%23bb0000'/&gt;
                                    &lt;stop offset='50%' stop-color='%23e76500'/&gt;
                                    &lt;stop offset='100%' stop-color='%23188918'/&gt;
                                &lt;/linearGradient&gt;
                            &lt;/defs&gt;
                            &lt;path d='M18 82 A50 50 0 0 1 142 82' fill='none' stroke='%23eee' stroke-width='12' stroke-linecap='round'/&gt;
                            &lt;path d='M18 82 A50 50 0 0 1 142 82' fill='none' stroke='url(%23gg2)' stroke-width='12' stroke-linecap='round' stroke-dasharray='157' stroke-dashoffset='28'/&gt;
                            &lt;text x='80' y='72' text-anchor='middle' font-size='24' font-weight='700' fill='%231d2d3e' font-family='Arial'&gt;82%&lt;/text&gt;
                            &lt;text x='14' y='96' font-size='9' fill='%23bb0000' font-family='Arial'&gt;0%&lt;/text&gt;
                            &lt;text x='132' y='96' font-size='9' fill='%23188918' font-family='Arial'&gt;100%&lt;/text&gt;
                        &lt;/svg&gt;
                        &lt;div style='display:flex;gap:8px;margin-top:4px;flex-wrap:wrap;justify-content:center'&gt;
                            &lt;span style='font-size:11px;padding:2px 8px;background:%23e8f7e8;color:%231a7a1a;border-radius:10px;font-weight:600'&gt;7 Compliant&lt;/span&gt;
                            &lt;span style='font-size:11px;padding:2px 8px;background:%23fff4e0;color:%23c65000;border-radius:10px;font-weight:600'&gt;3 Outdated&lt;/span&gt;
                        &lt;/div&gt;
                    &lt;/div&gt;

                    &lt;!-- Severity Donut --&gt;
                    &lt;div style='flex:1;background:%23fff;border:1px solid %23d9dbdd;border-radius:8px;padding:16px;box-shadow:0 1px 4px rgba(0,0,0,0.06);display:flex;flex-direction:column;align-items:center'&gt;
                        &lt;div style='font-size:13px;font-weight:600;color:%231d2d3e;margin-bottom:8px;text-align:center'&gt;Severity Breakdown&lt;/div&gt;
                        &lt;svg width='120' height='120' viewBox='0 0 130 130'&gt;
                            &lt;circle cx='65' cy='65' r='48' fill='none' stroke='%23bb0000' stroke-width='20' stroke-dasharray='85 216' stroke-dashoffset='0'/&gt;
                            &lt;circle cx='65' cy='65' r='48' fill='none' stroke='%23e76500' stroke-width='20' stroke-dasharray='96 216' stroke-dashoffset='-85'/&gt;
                            &lt;circle cx='65' cy='65' r='48' fill='none' stroke='%23188918' stroke-width='20' stroke-dasharray='35 216' stroke-dashoffset='-181'/&gt;
                            &lt;text x='65' y='60' text-anchor='middle' font-size='20' font-weight='700' fill='%231d2d3e' font-family='Arial'&gt;18&lt;/text&gt;
                            &lt;text x='65' y='76' text-anchor='middle' font-size='10' fill='%23888' font-family='Arial'&gt;violations&lt;/text&gt;
                        &lt;/svg&gt;
                        &lt;div style='margin-top:4px'&gt;
                            &lt;div style='display:flex;align-items:center;gap:6px;font-size:11px;margin-bottom:3px'&gt;&lt;span style='width:10px;height:10px;border-radius:50%;background:%23bb0000;display:inline-block'&gt;&lt;/span&gt;7 High&lt;/div&gt;
                            &lt;div style='display:flex;align-items:center;gap:6px;font-size:11px;margin-bottom:3px'&gt;&lt;span style='width:10px;height:10px;border-radius:50%;background:%23e76500;display:inline-block'&gt;&lt;/span&gt;8 Medium&lt;/div&gt;
                            &lt;div style='display:flex;align-items:center;gap:6px;font-size:11px'&gt;&lt;span style='width:10px;height:10px;border-radius:50%;background:%23188918;display:inline-block'&gt;&lt;/span&gt;3 Low&lt;/div&gt;
                        &lt;/div&gt;
                    &lt;/div&gt;

                &lt;/div&gt;"/>

                <!-- AI Briefing -->
                <Panel class="sapUiSmallMarginBottom">
                    <headerToolbar>
                        <Toolbar>
                            <core:Icon src="sap-icon://ai" color="Highlight" class="sapUiSmallMarginEnd"/>
                            <Title text="Executive Briefing" level="H5"/>
                            <ObjectStatus text="AI-powered" state="Information" class="sapUiSmallMarginBegin"/>
                            <ToolbarSpacer/>
                            <Button
                                text="{= ${appState>/execSummaryLoading} ? 'Generating...' : (${appState>/execSummary} ? 'Regenerate' : 'Generate Briefing') }"
                                icon="sap-icon://ai"
                                type="Emphasized"
                                press=".onGenerateBriefing"
                                enabled="{= !${appState>/execSummaryLoading} }"/>
                        </Toolbar>
                    </headerToolbar>
                    <content>
                        <VBox class="sapUiSmallMargin">
                            <BusyIndicator visible="{appState>/execSummaryLoading}" size="1rem"/>
                            <Text visible="{= !${appState>/execSummaryLoading} &amp;&amp; !${appState>/execSummary} }"
                                text="Click Generate Briefing to produce a CISO-ready executive summary with top 3 priority actions for this scan window."/>
                            <FormattedText visible="{= !${appState>/execSummaryLoading} &amp;&amp; !!${appState>/execSummary} }"
                                htmlText="{appState>/execSummary}"/>
                        </VBox>
                    </content>
                </Panel>

                <!-- Smart Triage -->
                <Panel class="sapUiSmallMarginBottom">
                    <headerToolbar>
                        <Toolbar>
                            <core:Icon src="sap-icon://ai" color="Highlight" class="sapUiSmallMarginEnd"/>
                            <Title text="Smart Triage" level="H5"/>
                            <ObjectStatus text="AI-powered" state="Information" class="sapUiSmallMarginBegin"/>
                            <ToolbarSpacer/>
                            <Button
                                text="{= ${appState>/triageLoading} ? 'Analyzing...' : (${appState>/triageInsights} ? 'Re-cluster' : 'Cluster Violations') }"
                                icon="sap-icon://ai"
                                press=".onGenerateTriage"
                                enabled="{= !${appState>/triageLoading} }"/>
                        </Toolbar>
                    </headerToolbar>
                    <content>
                        <VBox class="sapUiSmallMargin">
                            <BusyIndicator visible="{appState>/triageLoading}" size="1rem"/>
                            <Text visible="{= !${appState>/triageLoading} &amp;&amp; !${appState>/triageInsights} }"
                                text="Group 18 open violations into actionable themes with root cause analysis and recommended actions."/>
                            <List visible="{= !${appState>/triageLoading} &amp;&amp; !!${appState>/triageInsights} }"
                                items="{appState>/triageInsights}" showSeparators="None" backgroundDesign="Transparent">
                                <items>
                                    <CustomListItem>
                                        <Panel class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                            <content>
                                                <VBox class="sapUiSmallMargin">
                                                    <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
                                                        <ObjectStatus text="{appState>priority}" state="{path: 'appState>priority', formatter: '.formatter.severityState'}"/>
                                                        <Text text="{appState>count} violations" class="sapUiSmallText"/>
                                                    </HBox>
                                                    <Title text="{appState>title}" level="H6" class="sapUiSmallMarginBottom"/>
                                                    <Label text="Root Cause" design="Bold"/>
                                                    <Text text="{appState>rootCause}" wrapping="true" class="sapUiSmallMarginBottom"/>
                                                    <Label text="Recommended Action" design="Bold"/>
                                                    <Text text="{appState>action}" wrapping="true"/>
                                                </VBox>
                                            </content>
                                        </Panel>
                                    </CustomListItem>
                                </items>
                            </List>
                        </VBox>
                    </content>
                </Panel>

                <!-- Recent Violations -->
                <Panel class="sapUiSmallMarginBottom">
                    <headerToolbar>
                        <Toolbar>
                            <Title text="Recent High-Severity Violations" level="H5"/>
                            <ToolbarSpacer/>
                            <Button text="View all" type="Transparent" press=".onViewAllViolations"/>
                        </Toolbar>
                    </headerToolbar>
                    <content>
                        <Table items="{path: 'violations>/violations', filters: [{path: 'severity', operator: 'EQ', value1: 'High'}]}" growingThreshold="5" mode="None">
                            <columns>
                                <Column width="9rem"><Text text="ID"/></Column>
                                <Column width="10rem"><Text text="User"/></Column>
                                <Column><Text text="Conflicting Roles"/></Column>
                                <Column width="7rem"><Text text="Severity"/></Column>
                                <Column width="9rem"><Text text="Detected"/></Column>
                            </columns>
                            <items>
                                <ColumnListItem press=".onViolationPress" type="Navigation"
                                    highlight="{path: 'violations>severity', formatter: '.formatter.rowHighlight'}">
                                    <cells>
                                        <Text text="{violations>id}" class="sentinelMono"/>
                                        <ObjectIdentifier title="{violations>userName}" text="{violations>userId}"/>
                                        <HBox alignItems="Center">
                                            <Text text="{violations>roleA}" class="sentinelMono sentinelChip"/>
                                            <core:Icon src="sap-icon://arrow-right" class="sapUiSmallMarginBeginEnd"/>
                                            <Text text="{violations>roleB}" class="sentinelMono sentinelChip"/>
                                        </HBox>
                                        <ObjectStatus text="{violations>severity}"
                                            state="{path: 'violations>severity', formatter: '.formatter.severityState'}"
                                            icon="{path: 'violations>severity', formatter: '.formatter.severityIcon'}"/>
                                        <Text text="{violations>detected}" class="sentinelMono"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </content>
                </Panel>

                <!-- Top Risk Users -->
                <Panel>
                    <headerToolbar>
                        <Toolbar>
                            <Title text="Top Risk Users" level="H5"/>
                            <ToolbarSpacer/>
                            <Button text="View all" type="Transparent" press=".onViewAllUsers"/>
                        </Toolbar>
                    </headerToolbar>
                    <content>
                        <Table items="{path: 'users>/users', sorter: {path: 'riskScore', descending: true}}" growingThreshold="5" mode="None">
                            <columns>
                                <Column><Text text="User"/></Column>
                                <Column width="8rem"><Text text="Department"/></Column>
                                <Column width="14rem"><Text text="Risk Score"/></Column>
                                <Column width="7rem"><Text text="Status"/></Column>
                            </columns>
                            <items>
                                <ColumnListItem press=".onUserPress" type="Navigation">
                                    <cells>
                                        <HBox alignItems="Center">
                                            <Avatar initials="{users>initials}" backgroundColor="Accent6" displaySize="XS" class="sapUiSmallMarginEnd"/>
                                            <ObjectIdentifier title="{users>name}" text="{users>id}"/>
                                        </HBox>
                                        <Text text="{users>dept}"/>
                                        <ProgressIndicator
                                            percentValue="{users>riskScore}"
                                            displayValue="{users>riskScore}"
                                            width="160px"
                                            state="{path: 'users>riskScore', formatter: '.formatter.riskScoreState'}"/>
                                        <ObjectStatus text="{users>status}" state="{= ${users>status} === 'Active' ? 'Success' : 'Warning'}"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </content>
                </Panel>

            </VBox>
        </content>
    </Page>
</mvc:View>
